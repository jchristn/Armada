<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Description>CLI interface for Armada multi-agent orchestration</Description>
    <PackAsTool>true</PackAsTool>
    <!-- Battery fixtures require their .gitignore and .gitattributes files. Pack the publish payload intact. -->
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <ToolCommandName>armada</ToolCommandName>
    <PackageId>Armada.Helm</PackageId>
    <Version>1.3.0</Version>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.57.2" />
    <PackageReference Include="SyslogLogging" Version="2.4.1" />
    <PackageReference Include="Voltaic" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Test.Shared" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Armada.Core\Armada.Core.csproj" />
    <ProjectReference Include="..\Armada.Server\Armada.Server.csproj" />
    <ProjectReference Include="..\Armada.Tui\Armada.Tui.csproj" />
  </ItemGroup>

</Project>
