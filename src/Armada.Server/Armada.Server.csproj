<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Description>Admiral server for Armada multi-agent orchestration</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**\*" />
  </ItemGroup>

  <!-- Ship the committed React dashboard build next to the server binary (dashboard/), so packaged installs
       (NuGet tool, .pkg, .deb/.rpm, .msi) serve it at /dashboard instead of the legacy embedded pages. It stays
       outside the single-file bundle; the Docker build context has no dist/ and skips it. -->
  <ItemGroup Condition="Exists('..\Armada.Dashboard\dist\index.html')">
    <None Include="..\Armada.Dashboard\dist\**\*"
          Link="dashboard\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Test.Shared" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PolyPrompt" Version="3.1.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.12" />
    <PackageReference Include="Watson" Version="7.2.2" />
    <PackageReference Include="Voltaic" Version="2.2.1" />
    <PackageReference Include="SyslogLogging" Version="2.3.1" />
    <PackageReference Include="Radiant" Version="0.1.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Armada.Core\Armada.Core.csproj" />
    <ProjectReference Include="..\Armada.Runtimes\Armada.Runtimes.csproj" />
  </ItemGroup>

</Project>
