{
  "name": "armada",
  "displayName": "Armada",
  "description": "Armada in VS Code: connect to your Armada Admiral, navigate every Armada area, and work the mission and voyage black box (failures, FIX THIS briefs, recovery, timelines, attempt diffs, overlap previews, conflict decorations) with live updates.",
  "version": "1.3.0",
  "publisher": "lattice-ai",
  "license": "MIT",
  "icon": "media/icon.png",
  "homepage": "https://github.com/jchristn/armada",
  "repository": {
    "type": "git",
    "url": "https://github.com/jchristn/armada.git",
    "directory": "src/Armada.VSCode"
  },
  "bugs": {
    "url": "https://github.com/jchristn/armada/issues"
  },
  "engines": {
    "vscode": "^1.101.0",
    "node": ">=22"
  },
  "categories": [
    "Other",
    "AI"
  ],
  "keywords": [
    "armada",
    "agents",
    "orchestration",
    "missions",
    "black box",
    "failures"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "armada",
          "title": "Armada",
          "icon": "media/icon.png"
        }
      ]
    },
    "configuration": {
      "title": "Armada",
      "properties": {
        "armada.tenant": {
          "type": "string",
          "default": "",
          "description": "Optional tenant id (ten_...). Admin credentials use it to narrow lists to one tenant; other credentials are already scoped to their own tenant.",
          "order": 1
        },
        "armada.dashboardUrl": {
          "type": "string",
          "default": "",
          "description": "Armada dashboard URL used for dashboard links and Ask Armada. Empty means Harbor's configured dashboard for Harbor's Admiral, else the connected Admiral followed by /dashboard."
        },
        "armada.fixThis.openPreview": {
          "type": "boolean",
          "default": true,
          "description": "Open a Markdown preview beside the FIX THIS editor."
        },
        "armada.failures.showInExplorer": {
          "type": "boolean",
          "default": false,
          "description": "Also show the Armada Failures view in the Explorer (it always appears in the Armada view container)."
        },
        "armada.failures.filterToWorkspaceVessel": {
          "type": "boolean",
          "default": true,
          "description": "Show only entries for the vessel whose repository (git remote URL) is open. Falls back to every vessel when none matches."
        },
        "armada.failures.includeResolved": {
          "type": "boolean",
          "default": false,
          "description": "Also list resolved entries in the Armada Failures view."
        },
        "armada.failures.maxEntries": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "maximum": 500,
          "description": "Maximum entries loaded per vessel."
        },
        "armada.liveUpdates.useWebSocket": {
          "type": "boolean",
          "default": true,
          "description": "Listen for black box events on the Armada WebSocket. When the socket is unavailable the extension polls."
        },
        "armada.liveUpdates.pollIntervalSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 10,
          "maximum": 3600,
          "description": "Polling interval used when the WebSocket is disabled or down."
        },
        "armada.decorations.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Decorate files that conflicted in open entries and the vessel's hotspot directories."
        },
        "armada.decorations.hotspotLimit": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "maximum": 100,
          "description": "Number of hotspot directories to decorate (0 turns hotspot decorations off)."
        },
        "armada.notifications.onCapture": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification when a black box entry is captured for the open repository's vessel."
        }
      }
    },
    "views": {
      "armada": [
        {
          "id": "armadaNavigation",
          "name": "Navigation",
          "contextualTitle": "Armada",
          "icon": "media/icon.png"
        },
        {
          "id": "armadaFailures",
          "name": "Failures",
          "contextualTitle": "Armada",
          "icon": "media/icon.png"
        }
      ],
      "explorer": [
        {
          "id": "armadaFailuresExplorer",
          "name": "Armada Failures",
          "contextualTitle": "Armada",
          "when": "config.armada.failures.showInExplorer"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "armadaNavigation",
        "contents": "Connecting to the Armada Admiral...",
        "when": "armada.connectionState == connecting"
      },
      {
        "view": "armadaNavigation",
        "contents": "Not connected to an Armada Admiral. The extension uses the Admiral of a running Harbor, the local Admiral (~/.armada/settings.json) or a TUI profile, with the credentials already on this machine.\n[Connect](command:armada.connect)\n[Show Output](command:armada.showOutput)",
        "when": "!armada.connected && armada.connectionState != connecting"
      },
      {
        "view": "armadaFailures",
        "contents": "Connecting to the Armada Admiral...",
        "when": "armada.connectionState == connecting"
      },
      {
        "view": "armadaFailures",
        "contents": "Not connected to an Armada Admiral. The extension uses the Admiral of a running Harbor, the local Admiral (~/.armada/settings.json) or a TUI profile, with the credentials already on this machine.\n[Connect](command:armada.connect)\n[Show Output](command:armada.showOutput)",
        "when": "!armada.connected && armada.connectionState != connecting"
      },
      {
        "view": "armadaFailuresExplorer",
        "contents": "Connecting to the Armada Admiral...",
        "when": "armada.connectionState == connecting"
      },
      {
        "view": "armadaFailuresExplorer",
        "contents": "Not connected to an Armada Admiral. The extension uses the Admiral of a running Harbor, the local Admiral (~/.armada/settings.json) or a TUI profile, with the credentials already on this machine.\n[Connect](command:armada.connect)\n[Show Output](command:armada.showOutput)",
        "when": "!armada.connected && armada.connectionState != connecting"
      }
    ],
    "commands": [
      {
        "command": "armada.connect",
        "title": "Connect",
        "category": "Armada",
        "icon": "$(plug)"
      },
      {
        "command": "armada.reconnect",
        "title": "Reconnect",
        "category": "Armada",
        "icon": "$(refresh)"
      },
      {
        "command": "armada.disconnect",
        "title": "Disconnect",
        "category": "Armada",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "armada.showConnectionActions",
        "title": "Connection Actions...",
        "category": "Armada",
        "icon": "$(plug)"
      },
      {
        "command": "armada.showOutput",
        "title": "Show Output",
        "category": "Armada",
        "icon": "$(output)"
      },
      {
        "command": "armada.openSettings",
        "title": "Open Settings",
        "category": "Armada",
        "icon": "$(gear)"
      },
      {
        "command": "armada.openDashboard",
        "title": "Open Dashboard",
        "category": "Armada",
        "icon": "$(link-external)"
      },
      {
        "command": "armada.openDashboardPage",
        "title": "Open Dashboard Page",
        "category": "Armada",
        "icon": "$(link-external)"
      },
      {
        "command": "armada.refreshFailures",
        "title": "Refresh Failures",
        "category": "Armada",
        "icon": "$(refresh)"
      },
      {
        "command": "armada.toggleWorkspaceFilter",
        "title": "Toggle Workspace Vessel Filter",
        "category": "Armada",
        "icon": "$(filter)"
      },
      {
        "command": "armada.openEntry",
        "title": "Open Black Box",
        "category": "Armada"
      },
      {
        "command": "armada.openBlackBox",
        "title": "Open Black Box for Mission...",
        "category": "Armada",
        "icon": "$(open-preview)"
      },
      {
        "command": "armada.copyFixThis",
        "title": "Copy FIX THIS",
        "category": "Armada",
        "icon": "$(copy)"
      },
      {
        "command": "armada.openFixThisInEditor",
        "title": "Open FIX THIS in Editor",
        "category": "Armada",
        "icon": "$(markdown)"
      },
      {
        "command": "armada.sendFixThisToChat",
        "title": "Send FIX THIS to Chat",
        "category": "Armada",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "armada.runRecoveryPath",
        "title": "Run Recovery Path...",
        "category": "Armada",
        "icon": "$(debug-restart)"
      },
      {
        "command": "armada.resolveEntry",
        "title": "Resolve Black Box Entry",
        "category": "Armada",
        "icon": "$(check)"
      },
      {
        "command": "armada.addNote",
        "title": "Add Note",
        "category": "Armada",
        "icon": "$(note)"
      },
      {
        "command": "armada.askArmada",
        "title": "Ask Armada About This Failure",
        "category": "Armada",
        "icon": "$(question)"
      },
      {
        "command": "armada.showBlackBoxTimeline",
        "title": "Show Black Box Timeline",
        "category": "Armada",
        "icon": "$(history)"
      },
      {
        "command": "armada.compareBlackBoxAttempts",
        "title": "Compare Black Box Attempts",
        "category": "Armada",
        "icon": "$(diff)"
      },
      {
        "command": "armada.previewMissionOverlap",
        "title": "Preview Mission Overlap",
        "category": "Armada",
        "icon": "$(warning)"
      },
      {
        "command": "armada.draftArmadaFixMission",
        "title": "Draft Armada Fix Mission",
        "category": "Armada",
        "icon": "$(tools)"
      },
      {
        "command": "armada.showResilienceGaps",
        "title": "Show Resilience Gaps",
        "category": "Armada",
        "icon": "$(shield)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "armada.openDashboardPage",
          "when": "false"
        },
        {
          "command": "armada.disconnect",
          "when": "armada.connected || armada.connectionState == failed"
        },
        {
          "command": "armada.reconnect",
          "when": "armada.connected"
        },
        {
          "command": "armada.openDashboard",
          "when": "armada.connected"
        },
        {
          "command": "armada.openEntry",
          "when": "false"
        },
        {
          "command": "armada.refreshFailures",
          "when": "armada.connected"
        },
        {
          "command": "armada.openBlackBox",
          "when": "armada.connected"
        },
        {
          "command": "armada.copyFixThis",
          "when": "armada.connected"
        },
        {
          "command": "armada.openFixThisInEditor",
          "when": "armada.connected"
        },
        {
          "command": "armada.sendFixThisToChat",
          "when": "armada.connected"
        },
        {
          "command": "armada.runRecoveryPath",
          "when": "armada.connected"
        },
        {
          "command": "armada.resolveEntry",
          "when": "armada.connected"
        },
        {
          "command": "armada.addNote",
          "when": "armada.connected"
        },
        {
          "command": "armada.askArmada",
          "when": "armada.connected"
        },
        {
          "command": "armada.showBlackBoxTimeline",
          "when": "armada.connected"
        },
        {
          "command": "armada.compareBlackBoxAttempts",
          "when": "armada.connected"
        },
        {
          "command": "armada.previewMissionOverlap",
          "when": "armada.connected"
        },
        {
          "command": "armada.draftArmadaFixMission",
          "when": "armada.connected"
        },
        {
          "command": "armada.showResilienceGaps",
          "when": "armada.connected"
        }
      ],
      "view/title": [
        {
          "command": "armada.openDashboard",
          "when": "view == armadaNavigation && armada.connected",
          "group": "navigation@1"
        },
        {
          "command": "armada.showConnectionActions",
          "when": "view == armadaNavigation",
          "group": "navigation@2"
        },
        {
          "command": "armada.refreshFailures",
          "when": "view =~ /^armadaFailures/ && armada.connected",
          "group": "navigation@1"
        },
        {
          "command": "armada.toggleWorkspaceFilter",
          "when": "view =~ /^armadaFailures/ && armada.connected",
          "group": "navigation@2"
        },
        {
          "command": "armada.openBlackBox",
          "when": "view =~ /^armadaFailures/ && armada.connected",
          "group": "navigation@3"
        },
        {
          "command": "armada.previewMissionOverlap",
          "when": "view =~ /^armadaFailures/ && armada.connected",
          "group": "navigation@4"
        },
        {
          "command": "armada.showResilienceGaps",
          "when": "view =~ /^armadaFailures/ && armada.connected",
          "group": "navigation@5"
        },
        {
          "command": "armada.connect",
          "when": "view =~ /^armadaFailures/ && !armada.connected",
          "group": "connection@1"
        },
        {
          "command": "armada.disconnect",
          "when": "view =~ /^armadaFailures/ && armada.connected",
          "group": "connection@2"
        }
      ],
      "view/item/context": [
        {
          "command": "armada.copyFixThis",
          "when": "view =~ /^armadaFailures/ && viewItem =~ /^armadaEntry/",
          "group": "inline@1"
        },
        {
          "command": "armada.runRecoveryPath",
          "when": "view =~ /^armadaFailures/ && viewItem == armadaEntryOpen",
          "group": "inline@2"
        },
        {
          "command": "armada.openBlackBox",
          "when": "view =~ /^armadaFailures/ && viewItem =~ /^armadaEntry/",
          "group": "1_open@1"
        },
        {
          "command": "armada.copyFixThis",
          "when": "view =~ /^armadaFailures/ && viewItem =~ /^armadaEntry/",
          "group": "2_fixthis@1"
        },
        {
          "command": "armada.openFixThisInEditor",
          "when": "view =~ /^armadaFailures/ && viewItem =~ /^armadaEntry/",
          "group": "2_fixthis@2"
        },
        {
          "command": "armada.sendFixThisToChat",
          "when": "view =~ /^armadaFailures/ && viewItem =~ /^armadaEntry/",
          "group": "2_fixthis@3"
        },
        {
          "command": "armada.askArmada",
          "when": "view =~ /^armadaFailures/ && viewItem =~ /^armadaEntry/",
          "group": "2_fixthis@4"
        },
        {
          "command": "armada.draftArmadaFixMission",
          "when": "view =~ /^armadaFailures/ && viewItem =~ /^armadaEntry/",
          "group": "2_fixthis@5"
        },
        {
          "command": "armada.runRecoveryPath",
          "when": "view =~ /^armadaFailures/ && viewItem == armadaEntryOpen",
          "group": "3_act@1"
        },
        {
          "command": "armada.resolveEntry",
          "when": "view =~ /^armadaFailures/ && viewItem == armadaEntryOpen",
          "group": "3_act@2"
        },
        {
          "command": "armada.addNote",
          "when": "view =~ /^armadaFailures/ && viewItem =~ /^armadaEntry/",
          "group": "3_act@3"
        },
        {
          "command": "armada.showBlackBoxTimeline",
          "when": "view =~ /^armadaFailures/ && viewItem =~ /^armadaEntry/",
          "group": "4_forensics@1"
        },
        {
          "command": "armada.compareBlackBoxAttempts",
          "when": "view =~ /^armadaFailures/ && viewItem =~ /^armadaEntry/",
          "group": "4_forensics@2"
        }
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc -p ./ && tsc -p ./tsconfig.test.json",
    "bundle": "node esbuild.mjs --production",
    "build": "npm run typecheck && npm run bundle",
    "lint": "eslint . --max-warnings 0 && npm run lint:shared",
    "lint:shared": "cd .. && node Armada.VSCode/node_modules/eslint/bin/eslint.js --max-warnings 0 --config Armada.VSCode/eslint.dashboard-shared.config.mjs Armada.Dashboard/src",
    "compile-tests": "node esbuild.mjs --tests",
    "test": "npm run compile-tests && node --require ./out/test/setup.js --test \"out/test/unit/**/*.test.js\"",
    "test:integration": "npm run build && npm run compile-tests && node ./out/test/integration/runTest.js",
    "package": "node package-vsix.mjs",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/vscode": "1.101.0",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1"
  }
}
