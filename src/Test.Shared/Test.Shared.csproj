    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Armada.Core\Armada.Core.csproj" />
    <ProjectReference Include="..\Armada.Runtimes\Armada.Runtimes.csproj" />
    <ProjectReference Include="..\Armada.Server\Armada.Server.csproj" />
    <ProjectReference Include="..\Armada.Proxy\Armada.Proxy.csproj" />
    <ProjectReference Include="..\Armada.Client\Armada.Client.csproj" />
    <ProjectReference Include="..\Armada.Tui\Armada.Tui.csproj" />
  </ItemGroup>

</Project>
