<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Core models, database, and services for Armada multi-agent orchestration</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Prompts\persona-improvements.json" />
    <EmbeddedResource Include="Prompts\persona-briefs.json" />
    <EmbeddedResource Include="Prompts\persona-briefs-v1.json" />
    <EmbeddedResource Include="Prompts\persona-briefs-v2.json" />
    <EmbeddedResource Include="Prompts\persona-briefs-v3.json" />
    <EmbeddedResource Include="Prompts\persona-briefs-v4.json" />
    <EmbeddedResource Include="Prompts\persona-briefs-v5.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Test.Shared" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Blobject.AmazonS3" Version="6.1.2" />
    <PackageReference Include="Blobject.AzureBlob" Version="6.1.2" />
    <PackageReference Include="Blobject.CIFS" Version="6.1.2" />
    <PackageReference Include="Blobject.Core" Version="6.1.2" />
    <PackageReference Include="Blobject.Disk" Version="6.1.2" />
    <PackageReference Include="Blobject.GoogleCloud" Version="6.1.2" />
    <PackageReference Include="Blobject.NFS" Version="6.1.2" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="PolyPrompt" Version="3.5.0" />
    <PackageReference Include="PrettyId" Version="2.0.2" />
    <PackageReference Include="SyslogLogging" Version="2.4.1" />
  </ItemGroup>

  <!-- Keep SqlClient's PKCS dependency on the latest patched release for both target frameworks. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

</Project>
