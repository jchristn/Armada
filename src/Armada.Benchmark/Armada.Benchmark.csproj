<Project Sdk="Microsoft.NET.Sdk">

  <!-- Black-box benchmark harness: talks to the Admiral only over REST. No project references to the product. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <AssemblyName>Armada.Benchmark</AssemblyName>
    <RootNamespace>Armada.Benchmark</RootNamespace>
    <IsTestProject>false</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
